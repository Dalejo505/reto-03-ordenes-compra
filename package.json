{
  "name": "reto-03-ordenes-compra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agente conversacional que prepara y crea órdenes de compra en un SAP simulado",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm --prefix web install",
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch src/server.ts\" \"npm --prefix web run dev\"",
    "build": "npm --prefix web run build",
    "start": "tsx src/server.ts",
    "demo": "tsx demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3"
  }
}
