{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build && node scripts/build-api.mjs",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "{fixtures/**,agent/**,src/knowledge/**}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.mjs" }]
}
